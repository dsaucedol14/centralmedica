# Copia este archivo como .env y ajusta los valores.

# Puerto web (http://localhost:3100)
PORT=3100

# MySQL (Laragon: usuario root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=consultorio

# Cadena larga y aleatoria para firmar las sesiones. Cámbiala en producción.
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# Primer administrador: se crea al arrancar si no existe ningún administrador activo.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=consultorio-dev

# Carpeta de los archivos adjuntos de los expedientes (fuera de la carpeta pública)
UPLOADS_DIR=./uploads
# Tamaño máximo por archivo, en MB
UPLOAD_MAX_MB=20
