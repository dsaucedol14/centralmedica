<%- include('../partials/encabezado') %>
<h1><%= p.id ? 'Editar datos del paciente' : 'Nuevo paciente' %></h1>
<% if (p.id) { %><p class="tenue">Expediente <%= p.expediente %></p><% } %>
<% if (error) { %><div class="aviso error"><%= error %></div><% } %>

<form method="post" action="<%= p.id ? '/pacientes/' + p.id : '/pacientes' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <fieldset>
    <legend>Identificación</legend>
    <div class="rejilla tres">
      <div><label for="nombre">Nombre(s) *</label><input id="nombre" name="nombre" value="<%= p.nombre || '' %>" maxlength="80" required autofocus></div>
      <div><label for="apellido_paterno">Primer apellido *</label><input id="apellido_paterno" name="apellido_paterno" value="<%= p.apellido_paterno || '' %>" maxlength="80" required></div>
      <div><label for="apellido_materno">Segundo apellido</label><input id="apellido_materno" name="apellido_materno" value="<%= p.apellido_materno || '' %>" maxlength="80"></div>
      <div><label for="fecha_nacimiento">Fecha de nacimiento</label><input id="fecha_nacimiento" name="fecha_nacimiento" type="date" value="<%= p.fecha_nacimiento || '' %>"></div>
      <div>
        <label for="sexo">Sexo</label>
        <select id="sexo" name="sexo">
          <option value="">—</option>
          <option value="F" <%= p.sexo === 'F' ? 'selected' : '' %>>Mujer</option>
          <option value="M" <%= p.sexo === 'M' ? 'selected' : '' %>>Hombre</option>
        </select>
      </div>
      <div><label for="curp">CURP</label><input id="curp" name="curp" value="<%= p.curp || '' %>" maxlength="18" class="mayus"></div>
      <div><label for="estado_civil">Estado civil</label>
        <select id="estado_civil" name="estado_civil">
          <option value="">—</option>
          <% for (const e of ['Soltero(a)', 'Casado(a)', 'Unión libre', 'Divorciado(a)', 'Viudo(a)']) { %>
            <option <%= p.estado_civil === e ? 'selected' : '' %>><%= e %></option>
          <% } %>
        </select>
      </div>
      <div><label for="ocupacion">Ocupación</label><input id="ocupacion" name="ocupacion" value="<%= p.ocupacion || '' %>" maxlength="100"></div>
      <div><label for="tipo_sangre">Grupo sanguíneo</label>
        <select id="tipo_sangre" name="tipo_sangre">
          <option value="">—</option>
          <% for (const t of ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-']) { %>
            <option <%= p.tipo_sangre === t ? 'selected' : '' %>><%= t %></option>
          <% } %>
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Contacto</legend>
    <div class="rejilla tres">
      <div><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" value="<%= p.telefono || '' %>" maxlength="30"></div>
      <div><label for="email">Correo</label><input id="email" name="email" type="email" value="<%= p.email || '' %>" maxlength="120"></div>
      <div class="ancho2"><label for="domicilio">Domicilio</label><input id="domicilio" name="domicilio" value="<%= p.domicilio || '' %>" maxlength="250"></div>
      <div><label for="contacto_emergencia">Contacto de emergencia</label><input id="contacto_emergencia" name="contacto_emergencia" value="<%= p.contacto_emergencia || '' %>" maxlength="150" placeholder="Nombre y parentesco"></div>
      <div><label for="telefono_emergencia">Teléfono de emergencia</label><input id="telefono_emergencia" name="telefono_emergencia" type="tel" value="<%= p.telefono_emergencia || '' %>" maxlength="30"></div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Datos clínicos rápidos</legend>
    <label for="alergias">Alergias <span class="tenue">(salen resaltadas en todo el expediente y en las recetas)</span></label>
    <input id="alergias" name="alergias" value="<%= p.alergias || '' %>" maxlength="500" placeholder="Penicilina, AINEs, mariscos… o «Negadas»">
    <label for="notas">Notas administrativas</label>
    <textarea id="notas" name="notas" rows="2" maxlength="5000" placeholder="Aseguradora, forma de pago, observaciones…"><%= p.notas || '' %></textarea>
  </fieldset>

  <p class="acciones">
    <button class="btn" type="submit"><%= p.id ? 'Guardar cambios' : 'Crear expediente' %></button>
    <a class="btn sec" href="<%= p.id ? '/pacientes/' + p.id : '/pacientes' %>">Cancelar</a>
  </p>
</form>
<%- include('../partials/pie') %>
