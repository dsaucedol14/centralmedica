<%- include('../partials/encabezado') %>
<div class="cabecera">
  <h1>Pacientes</h1>
  <a class="btn" href="/pacientes/nuevo<%= busqueda ? '?nombre=' + encodeURIComponent(busqueda) : '' %>">+ Nuevo paciente</a>
</div>

<form class="filtros" method="get" action="/pacientes">
  <input type="search" name="q" value="<%= busqueda || '' %>" placeholder="Nombre, apellidos, expediente, CURP o teléfono" autofocus>
  <label class="casilla"><input type="checkbox" name="inactivos" value="1" <%= inactivos ? 'checked' : '' %>> Incluir archivados</label>
  <button class="btn sec" type="submit">Buscar</button>
</form>

<div class="tabla-wrap">
<table>
  <thead><tr><th>Exp.</th><th>Paciente</th><th>Edad</th><th>Sexo</th><th>Teléfono</th><th>Última consulta</th></tr></thead>
  <tbody>
  <% for (const p of pacientes) { %>
    <tr class="<%= p.activo ? '' : 'inactivo' %>">
      <td class="mono"><%= p.expediente %></td>
      <td>
        <a href="/pacientes/<%= p.id %>"><strong><%= f.nombreLista(p) %></strong></a>
        <% if (p.alergias) { %><span class="etiqueta alerta" title="<%= p.alergias %>">Alergias</span><% } %>
        <% if (!p.activo) { %><span class="etiqueta">Archivado</span><% } %>
      </td>
      <td><%= f.edad(p.fecha_nacimiento) %></td>
      <td><%= p.sexo === 'F' ? 'Mujer' : p.sexo === 'M' ? 'Hombre' : '' %></td>
      <td><%= p.telefono || '' %></td>
      <td><%= f.fecha(p.ultima_consulta) %></td>
    </tr>
  <% } %>
  <% if (!pacientes.length) { %>
    <tr><td colspan="6" class="vacio">
      <%= busqueda ? 'No se encontró ningún paciente con «' + busqueda + '».' : 'Aún no hay pacientes registrados.' %>
      <a href="/pacientes/nuevo<%= busqueda ? '?nombre=' + encodeURIComponent(busqueda) : '' %>">Registrar uno nuevo</a>
    </td></tr>
  <% } %>
  </tbody>
</table>
</div>
<% if (pacientes.length === 200) { %><p class="tenue">Se muestran los primeros 200. Afina la búsqueda para ver otros.</p><% } %>
<%- include('../partials/pie') %>
